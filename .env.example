# Copy to .env (git-ignored). Never commit real keys or tokens.

# --- AI provider ---
AI_PROVIDER=heuristic                 # heuristic | gemini | openai_compatible
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash         # stable Flash model at time of writing; see docs/DECISIONS.md
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=               # from your ShopAIKey (or other gateway) dashboard/docs
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_PROVIDER_NAME=ShopAIKey
AI_TIMEOUT_SECONDS=45
AI_MAX_ISSUE_CHARS=12000
AI_MAX_BATCH=25

# --- GitHub ---
GITHUB_TOKEN=                         # optional; fine-grained PAT (Issues: read, or read & write for allow-listed repos)
GITHUB_API_BASE=https://api.github.com
GITHUB_WRITE_ENABLED=false
WRITE_ALLOWED_REPOS=                  # comma-separated owner/repo list, exact match
MAX_SYNC_ISSUES=100

# --- Duplicate detection (heuristic thresholds, not validated) ---
DUP_RELATED_THRESHOLD=0.35
DUP_LIKELY_THRESHOLD=0.60

# --- App ---
# DATABASE_URL defaults to sqlite:///<repo>/data/issuepilot.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
